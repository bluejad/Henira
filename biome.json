{
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!packages/config-loader/src/models-dev-snapshot.json",
      "!**/dist-web",
      "!test-support/browser-e2e/test-results",
      "!test-support/browser-e2e/playwright-report",
      "!test-support/browser-e2e/artifacts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["plugins/web-ui/src/tokens.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
