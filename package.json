{
  "name": "henira",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b tsconfig.build.json && cp packages/config-loader/src/models-dev-snapshot.json packages/config-loader/dist/models-dev-snapshot.json && node scripts/copy-web-tokens.mjs",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm --filter @henira/e2e-browser test",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "check:deps": "node scripts/check-deps.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "check:ui-locale": "node scripts/check-ui-locale.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.28.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0",
    "jsdom": "^25.0.0"
  }
}
